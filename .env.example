# ============================================
# Toolkit Pro - Environment Variables
# ============================================
# এই ফাইলটি .env.example হিসাবে রাখুন
# Render.com-এ ডিপ্লয়ের সময় অটো-কনফিগার হবে
# লোকাল ডেভেলপমেন্টের জন্য .env ফাইল তৈরি করুন
# ============================================

# ----------------------------------------------
# সার্ভার কনফিগারেশন
# ----------------------------------------------
# Node.js এনভায়রনমেন্ট (production/development)
NODE_ENV=production

# সার্ভার পোর্ট (Render.com ফ্রি টিয়ারে 10000)
PORT=10000

# ----------------------------------------------
# ডাটাবেস কনফিগারেশন (PostgreSQL)
# ----------------------------------------------
# Render.com অটো-জেনারেট করবে
# লোকাল ডেভেলপমেন্টে PostgreSQL ইনস্টল করে ব্যবহার করুন
DATABASE_URL=postgresql://toolkit_admin:your_password@localhost:5432/toolkit_pro

# ডাটাবেস কানেকশন পুল সেটিংস
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ----------------------------------------------
# Redis ক্যাশে কনফিগারেশন
# ----------------------------------------------
# Render.com অটো-জেনারেট করবে
# লোকাল ডেভেলপমেন্টে Redis ইনস্টল করে ব্যবহার করুন
REDIS_URL=redis://localhost:6379

# Redis অপশনস
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_ENABLE_PERSISTENCE=true

# ----------------------------------------------
# JWT সিকিউরিটি
# ----------------------------------------------
# Render.com অটো-জেনারেট করবে
# লোকাল ডেভেলপমেন্টে শক্তিশালী সিক্রেট ব্যবহার করুন
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT এক্সপায়ারি টাইম
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------
# Google AdSense কনফিগারেশন
# ----------------------------------------------
# আপনার AdSense পাবলিশার ID (https://adsense.google.com)
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# AdSense এনাবল/ডিসএবল
ADSENSE_ENABLED=true

# AdSense অটো অ্যাডস
ADSENSE_AUTO_ADS=true

# অ্যাড স্লট IDs (AdSense থেকে জেনারেট করুন)
ADSENSE_SLOT_HEADER=1234567890
ADSENSE_SLOT_SIDEBAR=2345678901
ADSENSE_SLOT_IN_CONTENT=3456789012
ADSENSE_SLOT_RESULT_PAGE=4567890123
ADSENSE_SLOT_MOBILE_BANNER=5678901234

# ----------------------------------------------
# CORS কনফিগারেশন
# ----------------------------------------------
# প্রোডাকশনে নির্দিষ্ট ডোমেইন দিন
# ডেভেলপমেন্টে * ব্যবহার করুন
CORS_ORIGIN=*

# অ্যালাউড মেথডস
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# অ্যালাউড হেডারস
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ----------------------------------------------
# রেট লিমিটিং
# ----------------------------------------------
# উইন্ডো সময় (মিলিসেকেন্ডে)
RATE_LIMIT_WINDOW_MS=900000

# সর্বোচ্চ রিকোয়েস্ট (প্রতি উইন্ডো)
RATE_LIMIT_MAX_REQUESTS=100

# API স্পেসিফিক লিমিট
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=30

# অথেনটিকেশন লিমিট
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ----------------------------------------------
# ক্যাশে কনফিগারেশন
# ----------------------------------------------
# ক্যাশে TTL (সেকেন্ডে)
CACHE_TTL_DEFAULT=300
CACHE_TTL_TOOLS=600
CACHE_TTL_ADS=1800
CACHE_TTL_USER=60

# ক্যাশে এনাবল/ডিসএবল
CACHE_ENABLED=true

# ----------------------------------------------
# লগিং কনফিগারেশন
# ----------------------------------------------
# লগ লেভেল (error/warn/info/debug)
LOG_LEVEL=info

# লগ ফাইল পাথ
LOG_FILE_PATH=./logs

# লগ রিটেনশন (দিন)
LOG_RETENTION_DAYS=14

# ----------------------------------------------
# ইমেইল কনফিগারেশন (অপশনাল)
# ----------------------------------------------
# SMTP সেটিংস (ভবিষ্যতে ব্যবহারের জন্য)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Toolkit Pro <noreply@toolkitpro.com>

# ----------------------------------------------
# সোশ্যাল মিডিয়া (অপশনাল)
# ----------------------------------------------
# OAuth কনফিগারেশন (ভবিষ্যতে ব্যবহারের জন্য)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ----------------------------------------------
# অ্যানালিটিক্স (অপশনাল)
# ----------------------------------------------
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------
# CDN ও স্টোরেজ (অপশনাল)
# ----------------------------------------------
# Cloudinary/Imgur API (ইমেজ আপলোডের জন্য)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (ফাইল স্টোরেজের জন্য)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=toolkit-pro-storage

# ----------------------------------------------
# সিকিউরিটি হেডারস
# ----------------------------------------------
# Content Security Policy
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://pagead2.googlesyndication.com

# HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# ----------------------------------------------
# ফিচার ফ্ল্যাগস
# ----------------------------------------------
# কোন ফিচার এনাবল/ডিসএবল করবেন
FEATURE_USER_REGISTRATION=true
FEATURE_USER_LOGIN=true
FEATURE_TOOL_REVIEWS=true
FEATURE_TOOL_FAVORITES=true
FEATURE_TOOL_SHARING=true
FEATURE_DARK_MODE=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_PWA=true

# ----------------------------------------------
# ডিফল্ট ভাষা ও লোকালাইজেশন
# ----------------------------------------------
# ডিফল্ট ভাষা
DEFAULT_LANGUAGE=en

# সাপোর্টেড ভাষাসমূহ (কমা দিয়ে আলাদা)
SUPPORTED_LANGUAGES=en,bn,hi,es,fr,de,ja,ko,zh,ar,pt,ru,tr,vi,id,th,fil,ms,it,nl

# ডিফল্ট টাইমজোন
DEFAULT_TIMEZONE=UTC

# ডিফল্ট কারেন্সি
DEFAULT_CURRENCY=USD

# ----------------------------------------------
# পারফরম্যান্স টিউনিং
# ----------------------------------------------
# Node.js ক্লাস্টার (মাল্টি-কোর)
CLUSTER_ENABLED=false
CLUSTER_WORKERS=2

# কমপ্রেশন
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# বডি পার্সার লিমিট
BODY_PARSER_LIMIT=10mb

# টাইমআউট সেটিংস
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# ----------------------------------------------
# মনিটরিং (অপশনাল)
# ----------------------------------------------
# Sentry (এরর ট্র্যাকিং)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENABLED=false

# UptimeRobot (আপটাইম মনিটরিং)
UPTIME_ROBOT_API_KEY=your-uptime-robot-key

# ----------------------------------------------
# ডেভেলপমেন্ট সেটিংস
# ----------------------------------------------
# ডিবাগ মোড (শুধু ডেভেলপমেন্টে true)
DEBUG=false

# হট রিলোড (ডেভেলপমেন্টে)
HOT_RELOAD=true

# ----------------------------------------------
# নোটস
# ----------------------------------------------
# 1. প্রোডাকশনে সব সিক্রেট Render.com-এ সেট করুন
# 2. .env ফাইল কখনো GitHub-এ পুশ করবেন না
# 3. .env.example শুধু টেমপ্লেট হিসাবে রাখুন
# 4. AdSense ID অ্যাপ্রুভালের পর আপডেট করুন
# 5. JWT_SECRET অবশ্যই শক্তিশালী রাখুন
# ----------------------------------------------

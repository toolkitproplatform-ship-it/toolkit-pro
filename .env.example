# .env.example ফাইল তৈরি করুন
cat > .env.example << 'EOF'
# Application Settings
APP_NAME="Toolkit Pro"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC

# Database Settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toolkit_pro
DB_USERNAME=root
DB_PASSWORD=

# Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Mail Settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@toolkitpro.com
MAIL_FROM_NAME="Toolkit Pro"

# Security Settings
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=3600
ENCRYPTION_KEY=your-encryption-key
CIPHER=AES-256-CBC

# API Keys
OPENAI_API_KEY=your-openai-api-key
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_DECAY=60

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# CORS Settings
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# CDN Settings
CDN_URL=
CDN_ENABLED=false

# Monitoring
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
EOF

echo "✅ .env.example ফাইল তৈরি হয়েছে"

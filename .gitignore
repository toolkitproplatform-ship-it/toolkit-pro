# ============================================
# Toolkit Pro - Git Ignore File
# ============================================
# এই ফাইলগুলো GitHub-এ আপলোড হবে না
# ============================================

# ----------------------------------------------
# Node.js
# ----------------------------------------------
# ডিপেন্ডেন্সি
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# বিল্ড আউটপুট
dist/
build/
out/
.next/
.nuxt/

# NPM ক্যাশে
.npm/
.npmrc
package-lock.json.bak

# ----------------------------------------------
# এনভায়রনমেন্ট ভেরিয়েবল
# ----------------------------------------------
# সিকিউরিটি - কখনো GitHub-এ পুশ করবেন না
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ----------------------------------------------
# লগ ফাইল
# ----------------------------------------------
logs/
*.log
log/
tmp/
temp/

# ----------------------------------------------
# ডাটাবেস
# ----------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
database/*.sql
database/*.dump
database/*.backup

# ----------------------------------------------
# Redis
# ----------------------------------------------
dump.rdb
appendonly.aof
redis-data/

# ----------------------------------------------
# OS ফাইল
# ----------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ----------------------------------------------
# IDE ও এডিটর
# ----------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/
.project

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/
nbbuild/
nbdist/

# ----------------------------------------------
# টেস্টিং ও কভারেজ
# ----------------------------------------------
coverage/
.nyc_output/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.junit.xml

# ----------------------------------------------
# ক্যাশে ফাইল
# ----------------------------------------------
.cache/
.eslintcache
.stylelintcache
.cache-loader/
.parcel-cache/
.turbo/

# ----------------------------------------------
# কনফিগারেশন ফাইল (সিক্রেট)
# ----------------------------------------------
config.json
config.local.json
credentials.json
serviceAccountKey.json
firebase-admin.json
.secrets/
*.pem
*.key
*.cert
*.crt

# ----------------------------------------------
# আপলোড ও মিডিয়া
# ----------------------------------------------
uploads/
public/uploads/
storage/uploads/
media/
assets/uploads/
user-content/

# ----------------------------------------------
# টেম্পোরারি ফাইল
# ----------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
.~lock.*

# ----------------------------------------------
# কমপ্রেসড ফাইল
# ----------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ----------------------------------------------
# এক্সিকিউটেবল
# ----------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.bin
*.out

# ----------------------------------------------
# ডকুমেন্টেশন বিল্ড
# ----------------------------------------------
docs/_build/
docs/.doctrees/
site/
_site/

# ----------------------------------------------
# CI/CD
# ----------------------------------------------
.github/workflows/*.bak
.gitlab-ci-local.yml
.jenkins/
.circleci/local*

# ----------------------------------------------
# মনিটরিং
# ----------------------------------------------
.newrelic/
.sentry/
.elasticbeanstalk/
.serverless/

# ----------------------------------------------
# ডকার (যদি ব্যবহার করেন)
# ----------------------------------------------
docker-compose.override.yml
.docker/
docker-data/

# ----------------------------------------------
# SSL সার্টিফিকেট
# ----------------------------------------------
ssl/
certs/
*.p12
*.pfx

# ----------------------------------------------
# স্পেসিফিক প্রজেক্ট ফাইল
# ----------------------------------------------
# Toolkit Pro স্পেসিফিক
toolkit-pro.log
adsense-config.json
analytics-data.json
user-sessions.json
cache-data/
backup-data/
export-data/

# ----------------------------------------------
# এক্সেপশনস (যা আপলোড হবে)
# ----------------------------------------------
# এই ফাইলগুলো আপলোড করতে চাইলে
!.gitkeep
!.env.example
!README.md
!render.yaml
!package.json

# ----------------------------------------------
# নোটস
# ----------------------------------------------
# 1. .env ফাইল অবশ্যই ignore করবেন
# 2. node_modules কখনো কমিট করবেন না
# 3. লগ ফাইল GitHub-এ রাখবেন না
# 4. আপলোড করা ফাইল লোকাল স্টোরেজে থাকবে
# 5. সিকিউরিটি কী কখনো পুশ করবেন না
# ----------------------------------------------

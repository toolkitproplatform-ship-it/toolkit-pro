# composer.json ফাইল তৈরি করুন
cat > composer.json << 'EOF'
{
    "name": "toolkit/pro",
    "description": "Complete Online Tools Platform",
    "type": "project",
    "version": "1.0.0",
    "keywords": ["tools", "saas", "ai", "automation", "platform"],
    "license": "MIT",
    "authors": [
        {
            "name": "Toolkit Pro Team",
            "email": "support@toolkitpro.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.4",
        "predis/predis": "^2.1",
        "phpmailer/phpmailer": "^6.8",
        "guzzlehttp/guzzle": "^7.7",
        "monolog/monolog": "^3.4",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^2.71",
        "phpunit/phpunit": "^10.4",
        "symfony/var-dumper": "^6.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Controllers\\": "controllers/",
            "Models\\": "models/",
            "Services\\": "services/"
        },
        "files": [
            "core/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "check-style": "phpcs --standard=PSR12 src/",
        "fix-style": "phpcbf --standard=PSR12 src/",
        "analyse": "phpstan analyse",
        "serve": "php -S localhost:8000 -t public",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
EOF

echo "✅ composer.json ফাইল তৈরি হয়েছে"
